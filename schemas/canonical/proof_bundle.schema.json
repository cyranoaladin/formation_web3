{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rbk://schemas/canonical/proof_bundle.schema.json",
  "title": "RBK Proof Bundle (Canonical)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "proof_bundle_id",
    "run_id",
    "created_at",
    "artifacts"
  ],
  "properties": {
    "proof_bundle_id": {
      "type": "string",
      "pattern": "^proof_[a-f0-9]{16}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[a-f0-9]{16}$"
    },
    "submission_id": {
      "type": "string",
      "pattern": "^sub_[a-f0-9]{32}$"
    },
    "lab_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "logs": { "type": "string" },
        "tests": { "type": "string" },
        "diff": { "type": "string" },
        "audit": { "type": "string" },
        "result": {
          "type": "object",
          "additionalProperties": true,
          "required": ["status", "lab_id", "submission_id", "run_id", "started_at", "finished_at"],
          "properties": {
            "status": { "type": "string", "enum": ["ok", "failed"] },
            "lab_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "submission_id": { "type": "string", "pattern": "^sub_[a-f0-9]{32}$" },
            "run_id": { "type": "string", "pattern": "^run_[a-f0-9]{16}$" },
            "started_at": { "type": "string", "format": "date-time" },
            "finished_at": { "type": "string", "format": "date-time" },
            "error": { "type": "string" }
          }
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auto",
        "rubric"
      ],
      "properties": {
        "auto": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "rubric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "decision_hint": {
      "type": "string",
      "enum": [
        "needs_review",
        "validated",
        "failed"
      ]
    },
    "immutable": {
      "type": "boolean"
    },
    "sha256": {
      "type": "string"
    }
  }
}
